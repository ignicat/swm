# swm configuration: complete reference.
#
# This file lists every option with its default value and an explanation.
# swm does not read it. New installs get a minimal starter config instead
# (examples/swm.rune); copy any section you want to customize from here into
# your own config. Documentation for each subsystem lives in `docs/`.
#
# The default location for your config is:
#   $XDG_CONFIG_HOME/swm/swm.rune
# or, when XDG_CONFIG_HOME is unset:
#   $HOME/.config/swm/swm.rune
#
# swm creates this file only when it does not already exist. Startup never
# rewrites an existing config. swm does not back up or replace it.
# Edit settings and bindings yourself and check the result with
# `swmctl config verify`. While swm is running, valid saves are applied
# automatically. A syntactically invalid or incomplete save is rejected as one
# unit and the last valid configuration remains active.
#
# Sections and fields may be omitted unless noted otherwise; omitted values
# use their built-in defaults. `keybinds:` is required because it defines the
# compositor's input map. Strings are quoted, booleans are `true` or `false`,
# and each nested block ends with `end`.
# Nested Rune `gather` dependencies are watched with the root file, and the
# watched dependency set is refreshed after every accepted reload.

# Optional environment variables for applications launched by swm.
# Additions and changes apply to future launches after a valid live reload;
# already-running applications keep the environment they started with.
# Removing a variable takes effect after restarting swm.
#
# env:
#   QT_QPA_PLATFORM "wayland"
#   QT_QPA_PLATFORMTHEME "qt6ct"
# end

# Autostart launches session services through the same shell and environment
# as configured keybind commands. `once` runs only when a real TTY compositor
# session starts. `on-reload` runs after every valid config reload. Nested
# Winit development sessions run neither category.
autostart:
  # once "waybar"
  # once "mako"

  # on-reload "notify-send 'swm configuration reloaded'"
end

# `view` groups settings by physical output. Repeat `output:` inside this one
# section for each connector (find connector names and modes with
# `swmctl outputs`).
view:
  output:
    # DRM connector name exactly as printed by `swmctl outputs`.
    name "DP-1"

    # Display size multiplier: 1.0 = 100%, 1.5 = 150%, 2.0 = 200%.
    # Optional without width/height; keeps the preferred mode when omitted.
    # Monitor positions and UI dimensions are logical pixels.
    scale 1.0

    # Uncomment and edit the complete hardware group to select a mode. Width
    # and height must be supplied together; offset, rate, transform, and VRR
    # are only valid when both are present.
    # width 2560
    # height 1440
    # offset-x 0
    # offset-y 0

    # `rate` must exactly match an advertised mode. When omitted, swm uses
    # the highest advertised refresh for the configured width and height.
    # rate 179.998

    # Clockwise rotation in degrees: 0, 90, 180, or 270.
    # transform 0

    # "off", "on", or "auto". Auto enables VRR for a settled fullscreen
    # window when the backend can switch without a modeset.
    # vrr "auto"
  end

  output:
    name "DP-2"
    scale 1.0
  end
end

# Hardware output reloads are diffed per connector. Changing one output does
# not force an unchanged output through a redundant mode set.

# Keyboard, pointer-focus, physical-device, touch, and gesture settings.
# Keyboard/focus policy and client gesture protocols are backend-independent.
# Physical device settings apply when swm owns libinput devices on a tty.
input:
  # Key-repeat frequency in presses per second and the delay before repeating.
  # These drive clients and repeat-enabled compositor keybinds. A rate of 0
  # disables repeat. Both values update without restarting.
  repeat-rate 30
  repeat-delay 500

  # "click" keeps keyboard focus where you click. "hover" follows the pointer
  # across windows and outputs, but never raises windows merely by hovering.
  focus-mode "click"

  # Whether clicking a window also brings it to the top. When false, the click
  # still focuses and activates the window without changing stacking order.
  raise-on-click true

  keyboard:
    # Standard XKB names. Empty variant/options/model use XKB defaults.
    layout "us"
    variant ""
    options ""
    model ""
  end

  gestures:
    # Master switch for swm's camera gestures. Native client gestures are
    # still passed through when this is false if client-passthrough is true.
    enabled true

    # Send swipe, pinch, and hold sequences to the client under the pointer.
    # Raw touchscreen contacts are controlled separately by touch-passthrough.
    client-passthrough true
    touch-passthrough true

    # The default hybrid routing lets applications own gestures over their
    # windows and lets swm own gestures on empty field. Holding `modifier`
    # forces eligible gestures to swm. An active pointer constraint or
    # client grab always remains client-owned.
    pinch-to-zoom true
    pinch-scope "empty-field"      # "empty-field" or "global"
    compositor-scope "empty-field" # camera pan and ordinary action gestures
    modifier "mod"                 # keybind Mod; also "off" or an exact modifier

    # Two-finger touchpad scrolling pans only when it begins on empty field.
    # Use "off" to always pass finger scrolling through to clients.
    scroll-pan "empty-field"

    # Swipe finger count and optional momentum after a swipe/pinch pan.
    # Set pan-fingers to 0 to disable compositor swipe-panning.
    pan-fingers 3
    pan-momentum true
    pan-decay-rate 6.0
    flick-min-px-per-s 200.0

    # Discrete swipes use `swipe-DIRECTION-FINGERS`; while zoomed out to fit
    # they use `zoom-fit-swipe-DIRECTION-FINGERS`. Holds use `hold-FINGERS`.
    # Accepts any built-in keybind action except pointer grabs.
    # Configured bindings replace the defaults in their normal/zoom-fit map.
    # Zoom-fit open/close actions are global unless a pointer constraint or
    # client grab owns the sequence.
    swipe-threshold-px 120.0
    swipe-up-4 "zoom-fit-open"
    zoom-fit-swipe-down-4 "zoom-fit-close"
    # swipe-left-4 "trail-prev"
    # swipe-right-4 "trail-next"
    # hold-3 "toggle-state"
  end

  touchpad:
    # All fields are optional. Omission restores the device's own libinput
    # default. Unsupported capabilities are ignored by libinput.
    #
    # enabled true
    # natural-scroll false
    # accel-speed -0.5            # -1.0 through 1.0; sensitivity is an alias
    # accel-profile "adaptive"    # "adaptive" or "flat"
    # scroll-method "two-finger"  # "none", "two-finger", "edge", or
    #                             # "on-button-down"
    # scroll-button 274
    # scroll-button-lock false
    # left-handed false
    # middle-emulation false
    # tap true
    # tap-button-map "left-right-middle" # or "left-middle-right"
    # dwt true                    # disable while typing
    # click-method "clickfinger"  # or "button-areas"
    # drag true
    # drag-lock false
    # disabled-on-external-mouse false
  end

  mouse:
    # Every setting is optional. Omitted values preserve each device's own
    # libinput default, including after a live reload removes an old setting.
    #
    # enabled true
    # natural-scroll false
    # accel-speed 0.0
    # accel-profile "adaptive" # "adaptive" or "flat"
    # scroll-method "none"     # "none", "two-finger", "edge", or
    #                          # "on-button-down"
    # scroll-button 274        # Linux input button code
    # scroll-button-lock false
    # left-handed false
    # middle-emulation false
  end

  trackpoint:
    # Uses the same pointer fields as mouse. On-button scrolling is common:
    # scroll-method "on-button-down"
    # scroll-button 274
    # scroll-button-lock false
  end

  trackball:
    # Uses the same pointer fields as mouse.
    # accel-profile "flat"
    # middle-emulation true
  end

  touchscreen:
    # Raw contacts are exposed through wl_touch when a touchscreen is present.
    # map-to-output accepts an exact connector name. The calibration matrix is
    # libinput's row-major 2x3 affine transform.
    # enabled true
    # map-to-output "eDP-1"
    # calibration-matrix [1, 0, 0, 0, 1, 0]
  end

  # Optional exact-name overrides for individual devices. Names match
  # libinput's full device name, ignoring ASCII letter case; partial names do
  # not match. Values layer over the device's class block above.
  #
  # devices:
  #   "Logitech MX Master 3":
  #     accel-speed 0.6
  #     natural-scroll true
  #   end
  # end
end

# Cursor themes use the standard Xcursor search path and theme inheritance.
# Theme changes apply immediately to swm's compositor cursor. The theme
# and size are also exported to newly launched apps as XCURSOR_THEME and
# XCURSOR_SIZE; running apps may need a restart to adopt a new theme.
cursor:
  # This configured name is authoritative; swm does not inherit the theme
  # from its process environment. Theme names are case-sensitive.
  theme "default"

  # Base logical size. swm selects the closest frame supplied by the theme
  # for each output scale.
  size 24

  # Native DRM cursor planes are enabled when supported. Set true if the
  # driver produces cursor artifacts; reload applies the change.
  disable-hardware-cursor false

  # Hide after a physical keyboard press, without changing pointer focus,
  # grabs, or constraints. Pointer motion, buttons, and scrolling reveal it.
  hide-when-typing false

  # Hide only the rendered cursor while navigating swm with the keyboard.
  # The pointer position and hover/focus routing are not changed. Physical
  # pointer motion, buttons, and scrolling reveal it immediately.
  hide-on-keyboard-nav true

  # Hide on touch-down so a stale mouse cursor does not sit over touch UI.
  # Physical pointer activity reveals it again.
  hide-on-touch true

  # Hide after this many milliseconds without pointer activity. Set to 0 to
  # disable inactivity hiding.
  hide-after-ms 2000
end

# Window appearance settings. Borders apply only to managed top-level windows.
decorations:
  border:
    # Border width in logical pixels. It follows camera zoom visually.
    size 3

    # Focused and unfocused colors accept "#rrggbb" or shorthand "#rgb".
    colour-focused "#f4f5f7"
    colour-unfocused "#474d59"
  end

  # Resize managed windows by left-dragging their outer edge or corner. The
  # hit band stays 3 px wide when border size is 0 unless set to false.
  resize-using-border true

  # Outline drawn on directly screencast windows locally (not in streams).
  screencast-indicator:
    size 4
    colour "#f0333d"
  end
end

# Global font for compositor-owned UI. Every compositor label, badge, dialog,
# notification, and overlay uses this exact size.
font:
  family "monospace"
  size 11
end

# Shared compositor-owned UI. This styles Alt+Tab, configuration notices,
# the zoom indicator, and the exit confirmation.
# Window decorations and node labels keep their own existing configuration.
overlays:
  background-colour "auto"
  text-colour "auto"
  error-colour "#fb4934"
  border-colour "#d65d26"
  radius 8
  borders true
  border-size 3

  notifications:
    position "top-center"
    # Offset from the selected position; positive moves right/down.
    offset-x 0
    offset-y 0
    success-duration-ms 4000
    error-duration-ms 9000
  end

  # Per-monitor camera scale shown while zooming. Activity keeps the card
  # visible; the hold begins only after input and smooth motion stop.
  zoom-indicator:
    enabled true
    position "bottom-center"
    hold-duration-ms 750
    fade-duration-ms 180
    background true
    opacity 1.0

    # Optional per-indicator visual overrides. Leave these commented to
    # inherit the shared font, palette, border, and radius above.
    # text-size 18
    # text-colour "auto"
    # background-colour "auto"
    # border-colour "#d65d26"
    # borders true
    # radius 8
  end
end

# The compositor wallpaper is the absolute back of the scene: protocol
# background-layer surfaces, windows, panels, overlays, and the cursor all draw
# above it. "none" creates no wallpaper and leaves empty pixels plain black.
wallpaper:
  mode "none" # no wallpaper; or "classic"

  # Classic image example. Relative paths resolve beside this config file.
  # mode "classic"
  # path "~/Pictures/wallpaper.png"
  # fit "cover" # "cover", "contain", or "stretch"
  # intensity 1.0
end

# Window and layer-shell rules.
# Managed-window rules are shared by native Wayland and XWayland windows.
# Rules are checked top-to-bottom and only the first complete match applies.
# Exact strings are case-sensitive; r"..." values are regular expressions.
rules:
  # Set window-rule-mode "compose" to combine matching rules; later explicitly
  # specified properties override earlier ones. Omit it for first-match behavior.
  # window-rule-mode "compose"
  # window-rule:
  #   app-id ["firefox", r"org\.mozilla\..*"]
  #   title r"Picture.*"
  #   width 720
  #   height 520
  #   opacity 0.90
  #   game false  # Optional override; omit for automatic game detection.
  #   spawn-placement "cursor"
  # end
  #
  # Optional window-rule keys:
  #   match-all true
  #   match: / exclude: blocks with app-id, title, is-transient, at-startup,
  #     is-focused, is-screencast-target (do not mix match: or match-all with
  #     top-level app-id/title; dynamic focus/cast matchers allow live props only)
  #   open-on-output "DP-1", open-focused true|false, open-position [0, 0],
  #   open-fullscreen true|false, open-maximized true|false, border true|false,
  #   block-screencast true|false
  #   spawn-placement: "center" | "adjacent" | "viewport-center" | "cursor" | "app"
  #
  # layer-rule:
  #   namespace ["waybar", r"^fuzzel$"]
  #   layer ["top", "overlay"] # "background" | "bottom" | "top" | "overlay"
  #   block-screencast true
  # end
end

# Collapse focused work manually with Mod+N; its node remains clickable, and
# either the node or Mod+N restores the window immediately. Automatic decay is
# off by default. When enabled, a window left entirely off screen collapses
# after `delay-seconds` (10 minutes by default); a window you can see, even
# partly, never decays.
decay:
  enabled false
  delay-seconds 600
end

# Field behavior shared by active windows, collapsed landmarks, and camera
# movement. Active windows may overlap one another; only collapsed landmarks
# reserve readable space against nodes and active windows.
field:
  # Maximized windows are inset from the usable output area by this amount.
  # The same value is the clearance between landmarks and active windows.
  gap 20.0

  # Pinned windows and nodes stay locked in place; fullscreen hides the badge
  # with the rest of the compositor chrome.
  pins:
    corner "top-right"
    colour "#d65d26"
    background-colour "auto"
    size 1.0
  end

  # After the focused window closes, prefer a dialog's nearest surviving
  # parent, then fall back to same-output and global MRU order. Set this to
  # false to clear focus instead; the two settings below then have no effect.
  close-restore-focus true

  # The selected successor may already be a collapsed node. False keeps it
  # collapsed while making it swm's logical node focus, so node-aware
  # commands still target it without unexpectedly turning it back into a
  # window. True restores the node and focuses it as part of the close.
  close-restore-nodes false

  # Camera behavior after focusing an active successor or restoring a node:
  # "never" leaves the camera alone, "if-offscreen" minimally reveals only a
  # fully offscreen successor, and "always" centers the successor. A node kept
  # collapsed by close-restore-nodes false does not move the camera.
  close-restore-pan "if-offscreen"

  # Camera zoom changes both presentation and input coordinates. swm only
  # zooms outward: 1.0 is native size, and zooming in walks back toward 1.0
  # without magnifying beyond it.
  zoom:
    enabled true
    min 0.35
    step 1.10
    smooth-rate 12.5
  end
end

# Contact motion for nodes and node/window displacement. Off by default for
# rigid movement: pushing transfers directly to contacted nodes. Enable it for
# springy contact motion; `damping` only applies while enabled.
physics:
  enabled false
  damping 0.45
end

node:
  show-labels "hover"
  show-app-icons "always"
  shape "squircle"
  label-shape "squircle"
  icon-size 0.72
  opacity 1.0
  background-colour "auto"
  border-colour "#474d59"
  border-colour-highlighted "#d65d26"

  # "never", "if-offscreen", or "always". Panning and restoration begin
  # together; there is no center-first, restore-second interaction.
  click-collapsed-pan "never"
end

debug:
  # Graphics compatibility workaround. Requires restarting swm.
  # Set true to stop advertising explicit sync to applications.
  disable-explicit-sync false
end

# Browser-like per-monitor window focus history. Navigating the trail restores
# collapsed nodes and minimally reveals live windows without disturbing the
# forward history.
trail:
  history-length 32
  wrap true
end

# Animation settings are reloaded for future motion. Existing window-open and
# window-close animations keep the parameters with which they started.
animations:
  # Master switch for window-open, window-close, window-move, fullscreen,
  # maximize, smooth resize, and node animations.
  enabled true

  # CLI and keyboard Field movement. Pointer dragging remains direct.
  window-move:
    enabled true
    motion "easing"
    duration-ms 250
    curve "ease-out-cubic"
    # Or use motion "spring" with damping-ratio 1.0 and stiffness 800.0.
  end

  # Low-pass filtering for pointer-driven window resize. Lower durations hug
  # the pointer more tightly; release stops at the currently presented size.
  smooth-resize:
    enabled true
    duration-ms 90
  end

  window-open:
    # Independent switch for newly mapped windows.
    enabled true

    # Visual style:
    #   "center-out" - scale the window outward from its final center.
    #   "fade"       - keep the final geometry and fade from transparent to
    #                  opaque.
    #   "launch"     - travel along a short arc from the launcher, cursor,
    #                  focused window, or output center. The travel distance
    #                  is capped and the window settles after a tiny overshoot.
    type "center-out"

    # duration-ms is the complete time from the first frame through the
    # settled final frame. Curves redistribute progress inside that time:
    # "linear" advances evenly; "ease-out-quad", "ease-out-cubic", and
    # "ease-out-expo" cover increasingly more distance near the beginning;
    # "elastic" crosses the destination, then settles back. Launch applies
    # the curve once to travel while keeping its opacity and scale phases
    # anchored to the configured duration.
    duration-ms 300
    curve "linear"

    # Optional fragment shader; an empty/omitted path keeps the built-in type.
    # Paths are relative to the root config directory. Copy the shader there
    # before enabling it. See docs/window-shaders.md for the 900 ms wave setup.
    # custom-shader "shaders/open-wave.frag"

    # Recommended launch motion:
    # type "launch"
    # duration-ms 220
    # curve "ease-out-cubic"
    #
    # Window-open motion also accepts `motion "spring"`. With spring motion,
    # use damping-ratio and stiffness as documented below instead of
    # duration-ms and curve.
  end

  window-close:
    # Independent switch for ordinary Wayland and XWayland toplevels.
    enabled true

    # Close counterparts:
    #   "shrink"  - reverse "center-out" into the window's center.
    #   "fade"    - reverse "fade" without changing geometry.
    #   "retract" - reverse "launch" along the same restrained arc toward its
    #               remembered launch origin (or the current fallback origin).
    # Window-to-node transitions always fly and shrink into the node at the
    # window's original stack depth.
    type "shrink"

    # Optional close shader, independent of the opening shader.
    # custom-shader "shaders/close-wave.frag"

    # Close animations always use ease-in-out cubic timing internally.
    duration-ms 270
  end

  fullscreen:
    # Independent switch for fullscreen enter and exit transitions.
    enabled true

    # Motion model:
    #   "spring" - physically settles toward the target using the values
    #              below.
    #   "easing" - uses `duration-ms` and `curve` instead.
    motion "spring"

    # 1.0 is critically damped. Values below 1.0 permit bounce; values above
    # 1.0 remove overshoot but can settle more slowly.
    damping-ratio 1.0

    # Spring strength. Higher values reach the target more aggressively.
    stiffness 800.0

    # Example easing alternative:
    # motion "easing"
    # duration-ms 250
    # curve "ease-out-cubic"
  end

  maximize:
    # Maximize accepts the same spring/easing options as fullscreen (default: 240 ms ease-in-out cubic).
    enabled true

    # Easing motion:
    motion "easing"
    duration-ms 240
    curve "ease-in-out-cubic"

    # Spring alternative:
    # motion "spring"
    # damping-ratio 1.0
    # stiffness 800.0
  end

  node:
    enabled true
    duration-ms 280 # Node marker appearance.
    collapse-duration-ms 280 # Window snapshot shrinking/traveling into the node.
  end
end

# A keybind entry is `"chord" "action"`. Continuous built-in actions repeat
# automatically. Override any keyboard bind on one line with
# `"chord" "action" with repeat true|false`. A binding may also use
# `with scope "global|field"`. Modifiers are matched
# exactly: extra held modifiers prevent a chord from matching unless they are
# written into that chord. Trigger names are case-insensitive.
keybinds:
  # `$var.mod` in chord names expands to this modifier. Accepted values are
  # "super", "alt", "ctrl", and "shift", or an exact side such as
  # "left-super", "right-alt", or "left-ctrl".
  mod "super"

  # The normal Field loop: launch freely, position and overlap naturally,
  # collapse finished work with Mod+N, and retrieve it spatially.
  #
  # Built-in compositor actions.
  # `quit` opens the compositor-owned confirmation; Enter leaves and Escape
  # returns to the running session.
  "$var.mod+shift+e" "quit"
  "$var.mod+q" "close-focused"
  "$var.mod+f" "toggle-fullscreen"
  "$var.mod+m" "maximize-focused"
  # Collapse the focused window into its clickable node, or restore it. A single
  # click on the node does the same. Automatic decay, when enabled, is a
  # separate timer for windows left off screen.
  "$var.mod+n" "toggle-state"
  "$var.mod+p" "toggle-focused-pin"
  "$var.mod+o" "zoom-fit"
  "alt+tab" "cycle-focus"
  "alt+shift+tab" "cycle-focus-backward"
  # Focus the most recently used Field window and pan it to the center without
  # changing its geometry or restoring it from a collapsed node.
  "$var.mod+h" "center-last-focused"

  # Jump to the adjacent monitor and focus its most recently focused window.
  "$var.mod+shift+left" "monitor-focus left"
  "$var.mod+shift+right" "monitor-focus right"
  "$var.mod+shift+up" "monitor-focus up"
  "$var.mod+shift+down" "monitor-focus down"
  # Example exact connector target: "monitor-focus DP-1".

  # Contextual directional navigation: each arrow focuses the nearest window or
  # node in that direction.
  "$var.mod+left" "focus-left"
  "$var.mod+right" "focus-right"
  "$var.mod+up" "focus-up"
  "$var.mod+down" "focus-down"

  # Walk backward and forward through this monitor's Field focus history.
  "$var.mod+comma" "trail-prev"
  "$var.mod+period" "trail-next"

  # Optional keyboard camera panning. These actions repeat while held.
  # "$var.mod+shift+h" "pan-field left" with scope "field"
  # "$var.mod+shift+j" "pan-field down" with scope "field"
  # "$var.mod+shift+k" "pan-field up" with scope "field"
  # "$var.mod+shift+l" "pan-field right" with scope "field"

  # Move the focused or most-recent Field window/node by 80 Field units.
  # Optional distance: "node-move right 10" stops at obstacles along that axis.
  # Alt keeps this distinct from directional focus.
  "$var.mod+alt+left" "node-move left"
  "$var.mod+alt+right" "node-move right"
  "$var.mod+alt+up" "node-move up"
  "$var.mod+alt+down" "node-move down"


  # Send the selected Field window to an adjacent monitor and follow it.
  "$var.mod+alt+shift+left" "window-transfer left"
  "$var.mod+alt+shift+right" "window-transfer right"
  "$var.mod+alt+shift+up" "window-transfer up"
  "$var.mod+alt+shift+down" "window-transfer down"

  # Resize the focused Field window.
  "$var.mod+ctrl+left" "resize-window-left" with scope "field"
  "$var.mod+ctrl+right" "resize-window-right" with scope "field"
  "$var.mod+ctrl+up" "resize-window-up" with scope "field"
  "$var.mod+ctrl+down" "resize-window-down" with scope "field"

  # Re-read this file immediately. Valid saves are still watched automatically.
  "$var.mod+shift+r" "reload"

  # `default-terminal` launches the first installed terminal from swm's built-in
  # priority list. Replace this bind with e.g. `"$var.mod+t" "kitty"` to use
  # one command explicitly.
  "$var.mod+t" "default-terminal"

  # Open swm-lift, the separately installed search and action launcher. Lift searches
  # applications, running nodes, actions, and config files, and it can run
  # terminal commands.
  "$var.mod+d" "swm-lift"

  # Prefer a separate launcher instead? Fuzzel is an easy alternative:
  # "$var.mod+d" "fuzzel"

  # Any action string that is not a built-in action is executed as a command
  # line. These bindings control the default PipeWire sink through `wpctl`.
  "XF86AudioRaiseVolume" "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+ --limit 1.0" with repeat true
  "XF86AudioLowerVolume" "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-" with repeat true
  "XF86AudioMute" "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"

  # Zoom out, walk back inward, or reset directly to native scale.
  "$var.mod+minus" "zoom-out"
  "$var.mod+equal" "zoom-in"
  "$var.mod+shift+0" "zoom-reset"

  # Launch swm-screenshoter (standalone screenshot utility) when installed.
  "Print" "swm-screenshoter"

  # Compositor pointer grabs are ordinary remappable actions. Remove a line
  # to disable that grab, or put the action on a different button/chord.
  # The move action pans instead when the same grab starts on empty Field.
  # Drag-pan keeps a window on its output; dwell against an edge to carry it
  # through that output's Field instead of transferring it to another output.
  "$var.mod+click-left" "move-window"
  "$var.mod+click-right" "resize-window"
  "$var.mod+shift+click-left" "drag-pan"
  "click-left" "pan-field"

  # `pan-field` starts only on empty Field. To pan the camera from anywhere,
  # including over applications, bind `pan-field-always` to a chord with a
  # modifier (on a bare button it would take that button's click everywhere).
  # It is skipped over fullscreen windows and while fullscreen or maximize owns
  # the camera.
  #
  # "$var.mod+click-middle" "pan-field-always"

  # Keyboard, pointer-button, and physical-wheel triggers all use the same
  # chord syntax. Pointer and wheel bindings may also include `$var.mod`.
  # These are examples only; uncomment only the bindings you want.
  #
  # "$var.mod+Page_Up" "some-command"
  # "$var.mod+click-forward" "some-command"
  # "$var.mod+scroll-up" "zoom-in"
  # "$var.mod+scroll-down" "zoom-out"
  #
  # Unusual hardware can be addressed by its decimal Linux evdev code:
  # "keycode-99" "some-command"
  # "$var.mod+button-279" "some-command"
  #
  # See docs/keybinds.md for the complete trigger reference.

end
