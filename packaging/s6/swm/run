#!/bin/sh
# Example s6 longrun service for a user-owned supervision tree. A system-level
# seat manager such as seatd or elogind must already be running.

export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=SWM
export XDG_SESSION_DESKTOP=SWM
export DESKTOP_SESSION=SWM

exec /usr/bin/swm --session
